{
  "name": "wa-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Single-connection Baileys WhatsApp gateway: routes messages to consumer bots over a Unix domain socket. Transport only — zero business logic.",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.7.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "eslint": "^9.0.0"
  }
}
